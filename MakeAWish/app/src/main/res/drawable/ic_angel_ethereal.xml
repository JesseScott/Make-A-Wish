<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Overwashed Luminous Aura Background -->
    <path android:pathData="M 60,60 m -56,0 a 56,56 0 1,0 112,0 a 56,56 0 1,0 -112,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="56"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.4" android:color="#D0FFF8E7" />
                <item android:offset="0.8" android:color="#70E1BEE7" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Angel Wing (Left Arc) -->
    <path
        android:pathData="M 60,60 C 46,46 28,42 22,54 C 18,62 26,74 40,76 C 48,78 58,68 60,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="54"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#30FFFFFF" />
                <item android:offset="0.6" android:color="#B0FFF9C4" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Angel Wing (Right Arc) -->
    <path
        android:pathData="M 60,60 C 74,46 92,42 98,54 C 102,62 94,74 80,76 C 72,78 62,68 60,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="98"
                android:startY="54"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#30FFFFFF" />
                <item android:offset="0.6" android:color="#B0FFF9C4" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vertical Light Shaft -->
    <path
        android:pathData="M 60,18 Q 62,60 60,102 Q 58,60 60,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="18"
                android:endX="60"
                android:endY="102"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.3" android:color="#F0FFFFFF" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="0.7" android:color="#F0FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizontal Light Shaft -->
    <path
        android:pathData="M 18,60 Q 60,62 102,60 Q 60,58 18,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="60"
                android:endX="102"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.3" android:color="#F0FFFFFF" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="0.7" android:color="#F0FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Angelic Halo Ring -->
    <path
        android:pathData="M 60,30 A 28,12 0 1,0 60,54 A 28,12 0 1,0 60,30 Z M 60,34 A 24,8 0 1,1 60,50 A 24,8 0 1,1 60,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="88"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#E0FFECB3" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#E0FFE082" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- High-Exposure Bright Core -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 60,60 m -10,0 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0" />

</vector>
