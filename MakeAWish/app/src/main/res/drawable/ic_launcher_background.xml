<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Night Sky Gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0F172A" />
                <item android:offset="0.5" android:color="#FF1E1B4B" />
                <item android:offset="1.0" android:color="#FF31103F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Celestial Radial Glow Behind Star -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="56"
                android:centerY="42"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0.0" android:color="#48FFC107" />
                <item android:offset="0.45" android:color="#227C4DFF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
