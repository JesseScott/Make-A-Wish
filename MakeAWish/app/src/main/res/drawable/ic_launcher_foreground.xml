<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ethereal Angelic Wings / Light Arcs (Left Wing) -->
    <path
        android:pathData="M 54,54 C 42,42 26,38 20,48 C 16,55 24,66 36,68 C 44,70 52,62 54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="48"
                android:endX="54"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#20FFFFFF" />
                <item android:offset="0.6" android:color="#90FFF9C4" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ethereal Angelic Wings / Light Arcs (Right Wing) -->
    <path
        android:pathData="M 54,54 C 66,42 82,38 88,48 C 92,55 84,66 72,68 C 64,70 56,62 54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="88"
                android:startY="48"
                android:endX="54"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#20FFFFFF" />
                <item android:offset="0.6" android:color="#90FFF9C4" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vertical Light Shaft (High Exposure Beam) -->
    <path
        android:pathData="M 54,16 Q 56,54 54,92 Q 52,54 54,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="16"
                android:endX="54"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.3" android:color="#E0FFFFFF" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="0.7" android:color="#E0FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizontal Light Shaft -->
    <path
        android:pathData="M 16,54 Q 54,56 92,54 Q 54,52 16,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="54"
                android:endX="92"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.3" android:color="#E0FFFFFF" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="0.7" android:color="#E0FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagonal Soft Light Flares -->
    <path
        android:fillColor="#80FFF8E7"
        android:pathData="M 30,30 Q 54,54 78,78 Q 54,54 30,30 Z" />
    <path
        android:fillColor="#80FFF8E7"
        android:pathData="M 78,30 Q 54,54 30,78 Q 54,54 78,30 Z" />

    <!-- Luminous Angelic Halo Ring -->
    <path
        android:pathData="M 54,28 A 26,10 0 1,0 54,48 A 26,10 0 1,0 54,28 Z M 54,32 A 22,7 0 1,1 54,44 A 22,7 0 1,1 54,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#D0FFECB3" />
                <item android:offset="0.5" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#D0FFE082" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Overexposed Radiant Core -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 54,54 m -8,0 a 8,8 0 1,0 16,0 a 8,8 0 1,0 -16,0" />

    <!-- High Exposure Center Flare -->
    <path
        android:fillColor="#FFFFFCF2"
        android:pathData="M 54,54 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" />

</vector>
